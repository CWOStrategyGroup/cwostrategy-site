#=============================================================================
# CWO Strategy Group — _headers
#
# Portable header config. Honoured by Cloudflare Pages and Netlify.
#
# IMPORTANT: GitHub Pages IGNORES this file. While the origin is GitHub Pages,
# these headers must be applied at the Cloudflare edge instead — see
# SECURITY.md for the exact Transform Rule to create. This file exists so the
# policy is version-controlled and takes effect automatically if the origin
# ever moves to Cloudflare Pages.
#
# connect-src MUST include the Supabase project origin or the client portal
# cannot sign in or load analytics.
#=============================================================================

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://ajfekzqnajmcpcvqadtj.supabase.co; manifest-src 'self'; upgrade-insecure-requests

# Authenticated surfaces: never cached, never stored by an intermediary.
/portal.html
  Cache-Control: no-store, no-cache, must-revalidate, private
  Pragma: no-cache
  X-Robots-Tag: noindex, nofollow

/login.html
  Cache-Control: no-store, no-cache, must-revalidate, private
  X-Robots-Tag: noindex, nofollow

/reset-password.html
  Cache-Control: no-store, no-cache, must-revalidate, private
  X-Robots-Tag: noindex, nofollow

/auth.js
  Cache-Control: no-store, must-revalidate

/portal.js
  Cache-Control: no-store, must-revalidate

/login.js
  Cache-Control: no-store, must-revalidate

# Fingerprint-free static assets: long cache, revalidated by ETag.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/scroll.js
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800
